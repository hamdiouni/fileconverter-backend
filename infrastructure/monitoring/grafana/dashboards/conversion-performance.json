{
  "title": "Conversion Performance",
  "uid": "fileconverter-conversions",
  "tags": ["fileconverter", "conversions"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "panels": [
    {
      "title": "Conversions / min (by family)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "expr": "sum(rate(conversions_submitted_total[1m])) by (format_family) * 60",
        "legendFormat": "{{format_family}}"
      }]
    },
    {
      "title": "Queue Depth by Format Family",
      "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "expr": "conversion_queue_depth_gauge",
        "legendFormat": "{{format_family}}"
      }]
    },
    {
      "title": "Cache Hit Rate (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 8 },
      "targets": [{
        "expr": "sum(rate(cache_hit_total[5m])) / (sum(rate(cache_hit_total[5m])) + sum(rate(cache_miss_total[5m]))) * 100",
        "legendFormat": "cache hit %"
      }]
    },
    {
      "title": "Conversion Success Rate (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 8 },
      "targets": [{
        "expr": "sum(rate(conversion_jobs_completed_total[5m])) / (sum(rate(conversion_jobs_completed_total[5m])) + sum(rate(conversion_jobs_failed_total[5m]))) * 100",
        "legendFormat": "success %"
      }]
    },
    {
      "title": "Avg Conversion Duration (s) by Family",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(image_conversion_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "image p50"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(video_conversion_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "video p50"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(document_conversion_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "document p50"
        }
      ]
    }
  ]
}
