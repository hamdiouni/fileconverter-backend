# ═══════════════════════════════════════════════════════════════════════════
# FileConverter Pro - Environment Configuration Template
# ───────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# Required parameters are marked with [REQUIRED].
# Parameters with defaults may be omitted in development.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Node / Runtime ─────────────────────────────────────────────────────────
# NODE_ENV controls logging verbosity, security settings, and feature flags.
# Allowed values: development | staging | production
NODE_ENV=development

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
# Primary relational database used by all TypeScript services.

# [REQUIRED] Database connection URL (used by Prisma and service clients)
DATABASE_URL=postgresql://fileconverter:fileconverter_dev@localhost:5432/fileconverter

# Individual connection parameters (used by docker-compose)
POSTGRES_USER=fileconverter
POSTGRES_PASSWORD=fileconverter_dev        # [REQUIRED in production] Use a strong password
POSTGRES_DB=fileconverter
POSTGRES_PORT=5432

# Connection pool settings (per service)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=30000
DATABASE_IDLE_TIMEOUT_MS=60000

# ─── Redis ──────────────────────────────────────────────────────────────────
# Used for session caching, BullMQ job queues, and rate-limit counters.

# [REQUIRED] Full Redis connection URL
REDIS_URL=redis://:redis_dev_password@localhost:6379

REDIS_PASSWORD=redis_dev_password          # [REQUIRED in production] Use a strong password
REDIS_PORT=6379

# ─── Object Storage (MinIO / AWS S3) ────────────────────────────────────────
# Stores source files, converted results, and temporary worker scratch files.

# [REQUIRED] Access credentials
S3_ACCESS_KEY_ID=minioadmin               # AWS Access Key ID in production
S3_SECRET_ACCESS_KEY=minioadmin_dev       # [REQUIRED in production] Use IAM role or strong secret

# Endpoint – leave blank to use AWS S3; set to MinIO URL for local dev
S3_ENDPOINT=http://localhost:9000

S3_REGION=us-east-1
S3_BUCKET_UPLOADS=fileconverter-uploads
S3_BUCKET_RESULTS=fileconverter-results
S3_BUCKET_TEMP=fileconverter-temp

# MinIO console (local only)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev         # [REQUIRED in production]
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── JWT & Auth ─────────────────────────────────────────────────────────────

# [REQUIRED] Secret used to sign JWT access tokens – minimum 64 chars in production
JWT_ACCESS_SECRET=dev_access_secret_replace_in_production_min_64_chars

# [REQUIRED] Secret used to sign JWT refresh tokens
JWT_REFRESH_SECRET=dev_refresh_secret_replace_in_production_min_64_chars

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── OAuth Providers ────────────────────────────────────────────────────────

# Google OAuth (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/oauth/google/callback

# GitHub OAuth (leave blank to disable)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost/api/v1/auth/oauth/github/callback

# ─── Stripe Billing ─────────────────────────────────────────────────────────

# [REQUIRED in production] Stripe API keys
STRIPE_SECRET_KEY=sk_test_replace_with_real_key
STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_real_key

# [REQUIRED in production] Webhook secret for signature verification
STRIPE_WEBHOOK_SECRET=whsec_replace_with_real_secret

# Stripe price IDs for each subscription tier
STRIPE_PRICE_PRO_MONTHLY=price_replace_pro_monthly
STRIPE_PRICE_PRO_YEARLY=price_replace_pro_yearly
STRIPE_PRICE_BUSINESS_MONTHLY=price_replace_business_monthly
STRIPE_PRICE_BUSINESS_YEARLY=price_replace_business_yearly

# ─── Email / SMTP ───────────────────────────────────────────────────────────
# Local development uses Mailhog (http://localhost:8025).
# Production should use SendGrid or AWS SES.

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false                          # Set true for TLS (port 465)
SMTP_USER=                                 # Leave blank for Mailhog
SMTP_PASSWORD=                             # [REQUIRED] For SendGrid / SES

EMAIL_FROM_ADDRESS=noreply@fileconverter.io
EMAIL_FROM_NAME=FileConverter Pro

# SendGrid (alternative to SMTP)
SENDGRID_API_KEY=

# Mailhog ports (local dev only)
MAILHOG_SMTP_PORT=1025
MAILHOG_HTTP_PORT=8025

# ─── ClamAV Virus Scanner ───────────────────────────────────────────────────
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ─── Service Ports ──────────────────────────────────────────────────────────
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
AUTH_SERVICE_PORT=3000
USER_SERVICE_PORT=3001
UPLOAD_SERVICE_PORT=3002
ORCHESTRATOR_SERVICE_PORT=3003
BILLING_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
ADMIN_SERVICE_PORT=3006

# ─── Service Internal URLs ──────────────────────────────────────────────────
# Used for service-to-service communication inside the Docker network.
AUTH_SERVICE_URL=http://auth-service:3000
USER_SERVICE_URL=http://user-service:3001
UPLOAD_SERVICE_URL=http://upload-service:3002
ORCHESTRATOR_SERVICE_URL=http://orchestrator-service:3003
BILLING_SERVICE_URL=http://billing-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005
ADMIN_SERVICE_URL=http://admin-service:3006

# ─── Worker Concurrency ─────────────────────────────────────────────────────
# Number of concurrent jobs each worker instance handles.
# Production values are higher; see docker-compose.prod.yml for replicas.
IMAGE_WORKER_CONCURRENCY=2
VIDEO_WORKER_CONCURRENCY=1
AUDIO_WORKER_CONCURRENCY=2
DOCUMENT_WORKER_CONCURRENCY=2
ARCHIVE_WORKER_CONCURRENCY=1
CAD_WORKER_CONCURRENCY=1

# Production replica counts (used in docker-compose.prod.yml)
IMAGE_WORKER_REPLICAS=2
VIDEO_WORKER_REPLICAS=2
AUDIO_WORKER_REPLICAS=2
DOCUMENT_WORKER_REPLICAS=2
ARCHIVE_WORKER_REPLICAS=1
CAD_WORKER_REPLICAS=1

# ─── Frontend / CORS ────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Admin ──────────────────────────────────────────────────────────────────
# [REQUIRED in production] Seed admin user credentials
ADMIN_EMAIL=admin@fileconverter.io
ADMIN_PASSWORD=admin_dev_password          # [REQUIRED in production] Use a strong password

# ─── Rate Limiting ──────────────────────────────────────────────────────────
# Rate limits applied at the API Gateway (requests per window).
RATE_LIMIT_FREE_HOUR=100
RATE_LIMIT_FREE_DAY=1000
RATE_LIMIT_PRO_HOUR=10000
RATE_LIMIT_PRO_DAY=100000
RATE_LIMIT_BUSINESS_HOUR=100000
RATE_LIMIT_BUSINESS_DAY=1000000

# ─── File Retention ─────────────────────────────────────────────────────────
# Days uploaded/result files are retained per subscription tier.
RETENTION_FREE_DAYS=7
RETENTION_PRO_DAYS=14
RETENTION_BUSINESS_DAYS=30
RETENTION_ENTERPRISE_DAYS=90

# ─── Observability ──────────────────────────────────────────────────────────
LOG_LEVEL=info                            # debug | info | warn | error
LOG_FORMAT=json                           # json | pretty (use pretty in local dev)

# Prometheus metrics endpoint port (each service/worker exposes this separately)
METRICS_PORT=9090

# Distributed tracing (OpenTelemetry / Jaeger)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=fileconverter

# Grafana Loki log aggregation
LOKI_URL=http://loki:3100

# ─── Circuit Breaker ────────────────────────────────────────────────────────
# Thresholds for the circuit breaker protecting external service calls.
CIRCUIT_BREAKER_THRESHOLD=0.5            # Error rate to open circuit (0–1)
CIRCUIT_BREAKER_TIMEOUT_MS=60000         # How long circuit stays open (ms)
CIRCUIT_BREAKER_VOLUME_THRESHOLD=10      # Minimum requests before evaluation

# ─── Conversion Cache ───────────────────────────────────────────────────────
CONVERSION_CACHE_ENABLED=true
CONVERSION_CACHE_TTL_DAYS=30

# ─── Queue Configuration ────────────────────────────────────────────────────
BULLMQ_QUEUE_PREFIX=fc                   # Prefix for all BullMQ queue names
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY_MS=1000                  # Initial backoff; doubles each retry
JOB_STALENESS_TIMEOUT_MS=300000          # 5 minutes before job is considered stale

# ─── SSL / TLS (production) ─────────────────────────────────────────────────
# Paths to certificate files mounted into the api-gateway container.
SSL_CERT_PATH=/etc/nginx/certs/fullchain.pem
SSL_KEY_PATH=/etc/nginx/certs/privkey.pem
